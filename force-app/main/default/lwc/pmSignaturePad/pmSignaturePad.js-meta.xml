<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>PM Signature Pad</masterLabel>
    <description>Captures a handwritten signature in a screen flow and outputs it as a PNG data URL.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="label" type="String" label="Label" role="inputOnly" />
            <property name="required" type="Boolean" label="Required" role="inputOnly" />
            <property name="value" type="String" label="Signature (PNG data URL)" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
